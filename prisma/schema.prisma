generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  email       String        @id
  name        String?       @map("full_name")
  phoneNumber String?       @map("phone_number")
  location    String?
  accountType String?       @map("account_type")
  brandName   String?       @map("brand_name")
  password    String
  secretKey   String        @map("secret_key")
  sessions    UserSession[]

  @@map("users")
}

model Lead {
  id                Int      @id @default(autoincrement())
  addedBy           String?  @map("added_by")
  clientName        String?  @map("client_name")
  enquiryEntry      String?  @map("enquiry_entry")
  phoneNumber       String?  @map("phone_number")
  requirements      String?
  status            String?
  visitingStoreDate String?  @map("visiting_store_date")
  link              String?
  notes             String?
  log               String?  @db.Text
  source            String?  // "manual" | "meta" | "google_sheets"
  sourceId          String?  @map("source_id")
  externalId        String?  @map("external_id") @unique
  data              Json?    // dynamic fields
  projectId         String?  @map("project_id")
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model LeadSource {
  id           String    @id @default(cuid())
  type         String    // "meta" | "google_sheets"
  name         String
  clientName   String?   @map("client_name")
  config       Json      // sheets: {spreadsheetId, gid?}; meta: {pageId}
  columns      Json?     // cached column array from last sync
  lastSyncedAt DateTime? @map("last_synced_at")
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("lead_sources")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  integrations MetaIntegration[]
  sources      LeadSource[]
  leads        Lead[]

  @@map("projects")
}

model MetaIntegration {
  id               String    @id @default(cuid())
  name             String
  clientName       String?   @map("client_name")
  pageId           String    @map("page_id")
  pageName         String    @map("page_name")
  formId           String    @map("form_id")
  formName         String    @map("form_name")
  pageAccessToken  String    @map("page_access_token") @db.Text
  status           String    @default("active")
  projectId        String?   @map("project_id")
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  logs             LeadLog[]

  @@unique([formId])
  @@map("meta_integrations")
}

model LeadLog {
  id            String           @id @default(cuid())
  integrationId String?          @map("integration_id")
  integration   MetaIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  leadgenId     String?          @map("leadgen_id") @unique
  formId        String?          @map("form_id")
  formName      String?          @map("form_name")
  source        String?          @default("meta")
  status        String
  failureReason String?          @map("failure_reason") @db.Text
  rawData       Json?            @map("raw_data")
  retryCount    Int              @default(0) @map("retry_count")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@map("lead_logs")
}

model AccessModel {
  secretKeyHash String  @id @map("secret_key_hash")
  brandName     String? @map("brand_name")

  @@map("access_model")
}

model UserSession {
  token     String   @id @db.VarChar(64)
  userEmail String   @map("user_email")
  createdAt DateTime @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userEmail], references: [email])

  @@map("user_sessions")
}
